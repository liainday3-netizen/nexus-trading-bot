# Nexus Trading Bot — Environment Variables
# Copy this file to .env and fill in your values

# ── REQUIRED ──────────────────────────────────────────────
# Use a dedicated hot wallet holding only what you can afford to lose.
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── API KEYS (optional but recommended) ──────────────────
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── RPC (default: public mainnet) ─────────────────────────
# src/engine.js (npm start) reads SOLANA_RPC_URL; legacy bot.js reads RPC_URL.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com

# ── TRADING PARAMS ────────────────────────────────────────
# Note: src/engine.js sizes trades automatically from balance; these apply to legacy bot.js.
TRADE_SIZE_USD=5
MAX_TRADE_SIZE_USD=10
MIN_CONFIDENCE=0.62
INTERVAL_SECONDS=30
SLIPPAGE_BPS=100

# ── PER-TRADE EXITS ───────────────────────────────────────
TAKE_PROFIT_PCT=3.0
STOP_LOSS_TRADE_PCT=1.5

# ── PORTFOLIO SHIELD ──────────────────────────────────────
# Halts bot if total drawdown or daily loss exceeds these %
STOP_LOSS_PCT=10
DAILY_LOSS_PCT=3

# ── SAFETY ────────────────────────────────────────────────
# Paper trading by default. Set LIVE_MODE=true only after a reviewed paper run.
LIVE_MODE=false
DRY_RUN=true

# ── STORAGE ───────────────────────────────────────────────
BRAIN_FILE=./brain.json
